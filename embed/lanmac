def model_label(model: str):
    if not model:
        return ""
    return MODEL_NAMES.get(model, model)


def open_ports(dev):
    return {int(p) for p, on in (dev.get("ports") or {}).items() if on}


def classify_type(dev) -> str:
    """按 Bonjour 机型/服务 → 名称 → 端口 → 厂商 的顺序判定设备类型。"""
    model = (dev.get("model") or "").lower()
    model_name = (dev.get("model_name") or "").lower()
    name = (dev.get("name") or "").lower()
    host = (dev.get("hostname") or "").lower()
    vendor = (dev.get("vendor") or "").lower()
    services = dev.get("services") or set()
    ports = open_ports(dev)
    blob = " ".join([name, host, model_name])

    if dev.get("is_gateway"):
        return "router"
    if any(k in model for k in ("macbook", "imac", "macmini", "macpro", "macstudio")):
        return "mac"
    if any(k in blob for k in ("macbook", "mac mini", "imac", "mac studio", "mac pro")):
        return "mac"
    if "audioaccessory" in model or "homepod" in blob:
        return "speaker"
    if "appletv" in model or "apple tv" in blob:
        return "tv"
    if "iphone" in model or "iphone" in blob:
        return "phone"
    if "ipad" in model or "ipad" in blob:
        return "tablet"
    if "_ipp._tcp" in services or "_printer._tcp" in services:
        return "printer"
    if "_googlecast._tcp" in services:
        return "tv"
    if "_hap._tcp" in services:
        return "iot"
    if any(k in blob for k in ("printer", "laserjet", "laser ns", "mfp", "ricoh",
                               "sharp sf", "epson", "canon", "brother", "xerox")):
        return "printer"
    if any(k in blob for k in ("router", "gateway", "access point", "unifi",
                               "openwrt", "rt-", "mi-router")):
        return "router"
    if any(k in blob for k in ("diskstation", "synology", "qnap", " nas")):
        return "nas"
    if any(k in blob for k in ("iphone", "ipad", "android", "redmi", "pixel",
                               "galaxy", "honor", "oneplus")):
        return "phone"
    if 62078 in ports:
        return "phone"
    if 9100 in ports or 631 in ports:
        return "printer"
    if 3389 in ports:
        return "pc"
    if {5000, 5001} & ports:
        return "nas"
    if vendor.startswith("apple"):
        if 62078 in ports:
            return "phone"
        if ports & {445, 5900, 22, 7000}:
            return "mac"
        return "apple"
    for keywords, type_key in VENDOR_TYPE_HINTS:
        if any(k in vendor for k in keywords):
            return type_key
    if 445 in ports:
        return "pc"
    if 22 in ports:
        return "linux"
    return "unknown"


def type_label(type_key: str) -> str:
    return TYPE_LABELS.get(type_key, type_key)


def parse_type_filter(spec: str):
    """解析 --type 参数（key 或中文标签，逗号分隔）。"""
    keys = []
    for raw in (spec or "").split(","):
        token = raw.strip()
        if not token:
            continue
        low = token.lower()
        if low in TYPE_LABELS:
            keys.append(low)
        elif token in TYPE_BY_LABEL:
            keys.append(TYPE_BY_LABEL[token])
        else:
            raise SystemExit(
                "lanmac: 未知类型 %r，可选: %s（或中文：%s）"
                % (token, ", ".join(TYPE_ORDER),
                   "、".join(TYPE_LABELS[k] for k in TYPE_ORDER)))
    return keys


# --------------------------------------------------------------------------
# 发现主流程
# --------------------------------------------------------------------------

def discover(args):
    started = time.time()
    netinfo = system_network(args.iface, args.subnet)
    network = netinfo["network"]
    gateway = default_gateway()
    local_ip = netinfo["ip"]
    local_name = run_text(["scutil", "--get", "ComputerName"]).strip()
    oui, oui_source = load_oui(getattr(args, "oui_file", None))

    warnings = []
    arp = arp_table()

    # ---- ping 扫描 + Bonjour 浏览并行 ----
    def do_sweep():
        if args.fast or args.no_scan:
            return None
        return sweep(network, args.timeout)

    def do_browse():
        if args.no_bonjour or not have("dns-sd"):
            return None
        found = {}
        services = [s for s, _ in SERVICES]
        with ThreadPoolExecutor(max_workers=len(services)) as ex:
            futures = {
                ex.submit(browse_service, svc, args.browse): svc for svc in services
            }
            for fut in as_completed(futures):
                svc = futures[fut]
                try:
                    names = fut.result()
                except Exception:                   # noqa: BLE001 - 单服务失败不影响整体
                    names = []
                for name in names:
                    found.setdefault(name, {"services": set()})["services"].add(svc)
        return found

    with ThreadPoolExecutor(max_workers=2) as ex:
        f_sweep = ex.submit(do_sweep)
        f_browse = ex.submit(do_browse)
        swept = f_sweep.result()
        browsed = f_browse.result()

    if swept is None:
        alive = set(arp.keys()) if args.fast else set()
        warnings.append("已跳过 ping 扫描，在线状态按 ARP 缓存判断")
    else:
        alive = swept
    if browsed is None:
        instances = {}
        warnings.append("未执行 Bonjour 发现（dns-sd 不可用或已用 --no-bonjour）")
    else:
        instances = browsed

    # ---- 逐实例解析（并发） ----
    if instances:
        with ThreadPoolExecutor(max_workers=min(16, len(instances))) as ex:
            futures = {
                ex.submit(
                    lookup_device, name, inst["services"], args.lookup_timeout, network
                ): name
                for name, inst in instances.items()
            }
            for fut in as_completed(futures):
                name = futures[fut]
                try:
                    data = fut.result()
                except Exception:                   # noqa: BLE001
                    data = {}
                instances[name].update(data)

    # ---- 汇总设备 ----
    devices = {}
    by_ip = {}

    def record(ip):
        if ip in by_ip:
            return by_ip[ip]
        dev = {
            "name": None,
            "name_source": None,
            "name_pri": 0,
            "hostname": None,
            "ip": ip,
            "mac": arp.get(ip, {}).get("mac") if ip else None,
            "vendor": "",
            "model": None,
            "model_name": None,
            "services": set(),
            "ports": {},
            "online": False,
            "arp_cached": bool(ip and ip in arp),
            "type": "unknown",
            "is_local": False,
            "is_gateway": False,
        }
        by_ip[ip] = dev
        devices[ip or "?"] = dev
        return dev

    for name, inst in instances.items():
        ip = inst.get("ip")
        dev = record(ip) if ip else {
            "name": None, "name_source": None, "name_pri": 0, "hostname": inst.get("hostname"),
            "ip": None, "mac": None, "vendor": "", "model": None, "model_name": None,
            "services": set(), "ports": {}, "online": False, "arp_cached": False,
            "type": "unknown", "is_local": False, "is_gateway": False,
        }
        if not ip:
            devices["name:" + name] = dev
        priority = max((NAME_PRIORITY.get(s, 10) for s in inst["services"]), default=10)
        if dev.get("name") is None or priority > dev.get("name_pri", 0):
            dev["name"] = clean_instance_name(name, sorted(inst["services"])[0])
            dev["name_pri"] = priority
            dev["name_source"] = "bonjour"
        dev["services"] |= inst.get("services", set())
        dev["hostname"] = dev["hostname"] or inst.get("hostname")
        txt = inst.get("txt") or {}
        if txt.get("model") and not dev["model"]:
            dev["model"] = txt["model"]
            dev["model_name"] = model_label(txt["model"])

    if not args.fast and not args.no_scan:
        for ip in alive:
            record(ip)
    if args.stale or args.fast:
        for ip in arp:
            record(ip)
    if local_ip:
        record(local_ip)
        devices[local_ip]["online"] = True
        devices[local_ip]["name"] = devices[local_ip]["name"] or local_name or None
        devices[local_ip]["name_source"] = devices[local_ip]["name_source"] or "local"
        devices[local_ip]["is_local"] = True

    # ---- 端口探测（默认开启，--no-probe/--fast 关闭） ----
    probe_ports = None
    if args.ports:
        probe_ports = [int(p) for p in args.ports.split(",") if p.strip()]
    elif not (args.no_probe or args.fast):
        probe_ports = DEFAULT_PORTS
    probed = bool(probe_ports)
    if probe_ports:
        targets = [d for d in devices.values() if d.get("ip")]
        with ThreadPoolExecutor(max_workers=128) as ex:
            futures = {
                ex.submit(probe_port, d["ip"], port): (id(d), port)
                for d in targets for port in probe_ports
            }
            by_id = {id(d): d for d in targets}
            for fut in as_completed(futures):
                did, port = futures[fut]
                try:
                    is_open = fut.result()
                except Exception:                   # noqa: BLE001
                    is_open = False
                by_id[did]["ports"][str(port)] = is_open

    # ---- 补 MAC / 厂商 / 在线状态 ----
    for dev in devices.values():
        ip = dev["ip"]
        if ip and ip in arp:
            dev["mac"] = normalize_mac(dev["mac"] or arp[ip]["mac"])
        if dev["mac"]:
            dev["vendor"] = vendor_for(dev["mac"], oui)
        dev["online"] = bool(ip and ip in alive)
        if args.fast or args.no_scan:
            dev["online"] = bool(ip and ip in arp)
        if not dev["model_name"]:
            dev["model_name"] = model_label(dev["model"])
        dev["is_gateway"] = bool(gateway and ip == gateway)
        if dev["is_gateway"] and not dev["name"]:
            dev["name"] = "网关（路由器）"
            dev["name_source"] = "gateway"

    # ---- 补名称（可选，SMB/NetBIOS） ----
    if getattr(args, "names", False):
        targets = [d for d in devices.values()
                   if d.get("ip") and d.get("online") and not d.get("name")]
        if targets:
            with ThreadPoolExecutor(max_workers=32) as ex:
                futures = {ex.submit(smb_name, d["ip"]): d for d in targets}
                for fut in as_completed(futures):
                    dev = futures[fut]
                    try:
                        name = fut.result()
                    except Exception:               # noqa: BLE001
                        name = None
                    if name:
                        dev["name"] = name
                        dev["name_source"] = "smb"

    # ---- 判定类型 ----
    for dev in devices.values():
        dev["type"] = classify_type(dev)
        # Bonjour 机型能证明是 Apple 设备时，厂商列直接给 Apple（设备可能是随机 MAC）
        if (dev["model"] or "").startswith(("Mac", "AppleTV", "AudioAccessory",
                                            "iPhone", "iPad", "Watch")):
            dev["vendor"] = "Apple"
        elif dev["type"] in ("mac", "apple") and dev["vendor"] in ("", "随机 MAC"):
            dev["vendor"] = "Apple"

    result = {
        "version": VERSION,
        "scanned": {
            "subnet": str(network),
            "iface": netinfo["iface"],
            "local_ip": local_ip,
            "local_name": local_name,
            "gateway": gateway,
            "duration_s": round(time.time() - started, 2),
            "alive_hosts": len(alive),
            "bonjour_devices": len(instances),
            "probed": probed,
            "oui_source": oui_source,
        },
        "warnings": warnings,
        "devices": list(devices.values()),
    }
    return result


# --------------------------------------------------------------------------
# 过滤 / 排序 / 输出
# --------------------------------------------------------------------------

def filter_devices(devices, args):
    out = list(devices)
    if getattr(args, "filter", None):
        try:
            pat = re.compile(args.filter, re.I)
        except re.error as exc:
            raise SystemExit(f"lanmac: 无效的 --filter 正则: {exc}")
        fields = ("name", "hostname", "ip", "model_name", "vendor",
                  "type", "mac", "hostname")
        out = [d for d in out
               if any(pat.search(str(d.get(k) or "")) for k in fields)]
    if getattr(args, "mac", False):
        out = [d for d in out if d.get("type") == "mac"]
    types = getattr(args, "types", None) or []
    if types:
        out = [d for d in out if d.get("type") in types]
    if getattr(args, "named", False):
        out = [d for d in out if d.get("name")]
    if getattr(args, "keywords", None):
        kws = [k.lower() for k in args.keywords]
        def blob(d):
            fields = ("name", "hostname", "ip", "model_name", "vendor")
            return " ".join([str(d.get(f) or "") for f in fields]
                            + [type_label(d.get("type") or "")]).lower()
        out = [d for d in out if any(k in blob(d) for k in kws)]
    return out


def sort_devices(devices, key):
    if key == "name":
        return sorted(devices, key=lambda d: (d.get("name") or "~").lower())
    if key == "model":
        return sorted(devices, key=lambda d: (d.get("model_name") or "~",
                                              d.get("name") or ""))
    if key == "type":
        order = {k: i for i, k in enumerate(TYPE_ORDER)}
        return sorted(devices, key=lambda d: (order.get(d.get("type"), 99),
                                              _ip_key(d.get("ip"))))
    return sorted(devices, key=lambda d: _ip_key(d.get("ip")))


def _ip_key(ip):
    if not ip:
        return (1, 0)
    try:
        return (0, int(ipaddress.ip_address(ip)))
    except ValueError:
        return (1, 0)


def service_labels(services):
    labels = {SERVICE_LABELS.get(s, s) for s in services}
    return [lbl for lbl in SERVICE_ORDER if lbl in labels]


def service_text(services) -> str:
    # 去重（_ipp 与 _printer 都显示“打印”）
    deduped = []
    for lbl in service_labels(services):
        if lbl not in deduped:
            deduped.append(lbl)
    return " / ".join(deduped) if deduped else "-"


def open_port_text(dev) -> str:
    ports = sorted(open_ports(dev))
    return ",".join(str(p) for p in ports) if ports else "-"


def cell_value(dev, column):
    if column == "name":
        return dev.get("name") or "-"
    if column == "type":
        return type_label(dev.get("type") or "unknown")
    if column == "ip":
        return dev.get("ip") or "-"
    if column == "hostname":
        return (dev.get("hostname") or "-").replace(".local", "")
    if column == "vendor":
        return truncate(dev.get("vendor") or "-", 34)
    if column == "mac":
        return dev.get("mac") or "-"
    if column == "ports":
        return open_port_text(dev)
    if column == "services":
        return service_text(dev.get("services") or set())
    if column == "status":
        if dev.get("is_local"):
            return "本机"
        if dev.get("online"):
            return "在线"
        if dev.get("arp_cached"):
            return "ARP缓存"
        if dev.get("ip"):
            return "无响应"
        return "IP 未知"
    return "-"


def render_table(devices, args):
    columns = args.columns
    headers = [COLUMN_LABELS[c] for c in columns]
    rows = [[cell_value(d, c) for c in columns] for d in devices]

    widths = [dwidth(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], dwidth(cell))

    lines = ["  ".join(pad(h, widths[i]) for i, h in enumerate(headers)).rstrip(),
             "  ".join("-" * widths[i] for i in range(len(headers)))]
    for row in rows:
        lines.append("  ".join(pad(c, widths[i]) for i, c in enumerate(row)).rstrip())
    return "\n".join(lines)


def print_report(result, args):
    scan = result["scanned"]
    devs = result["devices"]

    if args.json:
        payload = {
            "version": result["version"],
            "scanned": scan,
            "warnings": result["warnings"],
            "devices": [
                {
                    "name": d["name"],
                    "name_source": d["name_source"],
                    "type": d["type"],
                    "type_label": type_label(d["type"]),
                    "model": d["model"],
                    "model_name": d["model_name"] or None,
                    "ip": d["ip"],
                    "hostname": d["hostname"],
                    "mac": d["mac"],
                    "vendor": d["vendor"],
                    "services": service_text(d["services"]).split(" / ")
                               if d["services"] else [],
                    "service_types": sorted(d["services"]),
                    "ports": d["ports"],
                    "open_ports": sorted(open_ports(d)),
                    "online": d["online"],
                    "arp_cached": d["arp_cached"],
                    "is_local": d["is_local"],
                    "is_gateway": d["is_gateway"],
                }
                for d in devs
            ],
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return

    title = f"lanmac {VERSION}  ·  网段 {scan['subnet']} ({scan['iface']})"
    if scan.get("local_ip"):
        title += f"  ·  本机 {scan['local_ip']}（{scan['local_name'] or '-'}）"
    print(title)
    online = result.get("online_total", sum(1 for d in devs if d["online"]))
    total = result.get("total", len(devs))
    shown = "" if total == len(devs) else "（显示 %d 行）" % len(devs)
    if scan.get("probed"):
        print("发现 %d 台设备 · 在线 %d · 扫描耗时 %.1fs%s"
              % (total, online, scan["duration_s"], shown))
    else:
        print("发现 %d 台设备 · 在线 %d（未探测端口）· 扫描耗时 %.1fs%s"
              % (total, online, scan["duration_s"], shown))
    for w in result["warnings"]:
        print("! " + w)
    print()

    if not devs:
        print("没有发现设备。可能原因：\n"
              "  · 终端没有「本地网络」权限 → 系统设置 > 隐私与安全性 > 本地网络\n"
              "  · 目标网段不对（可试 -s 或 -i）\n"
              "  · 目标与你不在此网段（如连接了 VPN）")
        return

    print(render_table(devs, args))

    # 类型汇总（基于过滤后的全量，不受 --limit 影响）
    counts = result.get("type_counts") or {}
    parts = [f"{TYPE_LABELS[k]} {counts[k]}"
             for k in TYPE_ORDER if k in counts]
    print("\n共 %d 台：%s。" % (total, "，".join(parts)))

    if any(d.get("arp_cached") and not d["online"] for d in devs):
        print("说明：「ARP缓存」= 有 ARP 记录但 ping 无响应（设备休眠或防火墙禁 ping）。")
    unknown = counts.get("unknown", 0)
    if unknown and not (args.ports or args.names):
        print("提示：%d 台类型未知，可用 --names（读 SMB 机器名）或 -p 指定更多端口提高识别率。"
              % unknown)


def build_parser():
    p = argparse.ArgumentParser(
        prog="lanmac",
        description="局域网设备发现 / IP 查询（macOS，默认枚举所有设备类型）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例:
  lanmac                       扫描当前网段所有设备（默认）
  lanmac -m                    只看 Mac 电脑
  lanmac --type printer,phone  只看打印机和手机
  lanmac -j                    输出 JSON
  lanmac --columns name,type,ip,vendor,ports,status
  lanmac --fast                快速模式（只读 ARP，约 3 秒）
  lanmac 192.168.10.172        只看指定 IP
  lanmac -f 'MacBook Pro'      按名称/厂商/类型正则过滤
""",
    )
    p.add_argument("keywords", nargs="*", metavar="关键字",
                   help="按 IP / 名称 / 厂商 / 类型关键字过滤（可多个）")
    p.add_argument("-s", "--subnet", help="扫描网段，如 192.168.1.0/24（默认自动）")
    p.add_argument("-i", "--iface", help="指定网卡接口，如 en0（默认跟随默认路由）")
    p.add_argument("-t", "--timeout", type=float, default=0.8,
                   help="ping 单机等待秒数（默认 0.8）")
    p.add_argument("-b", "--browse", type=float, default=5.0,
                   help="Bonjour 浏览时长秒数（默认 5）")
    p.add_argument("--lookup-timeout", type=float, default=3.0,
                   help="单个设备 mDNS 解析时长秒数（默认 3）")
    p.add_argument("-p", "--ports", help="自定义探测端口，逗号分隔（默认探测常见端口）")
    p.add_argument("--no-probe", action="store_true", help="不探测端口（更快，但类型判定变弱）")
    p.add_argument("-y", "--type", dest="type_spec", metavar="TYPES",
                   help="按类型过滤，逗号分隔：mac,phone,printer,router,tv,nas,"
                        "camera,iot,speaker,pc,linux,tablet,apple,unknown（也接受中文）")
    p.add_argument("-m", "--mac", action="store_true", help="只显示 Mac 电脑")
    p.add_argument("-n", "--names", action="store_true",
                   help="用 SMB/NetBIOS 补全无 Bonjour 名称的设备（较慢）")
    p.add_argument("--stale", action="store_true",
                   help="同时显示仅在 ARP 缓存里、当前 ping 不通的设备")
    p.add_argument("-f", "--filter", help="按名称/厂商/IP/类型正则过滤")
    p.add_argument("-j", "--json", action="store_true", help="输出 JSON")
    p.add_argument("--fast", action="store_true",
                   help="快速模式：跳过 ping 与端口探测，仅用 ARP 缓存（约 3 秒）")
    p.add_argument("--no-scan", action="store_true", help="跳过 ping 扫描")
    p.add_argument("--no-bonjour", action="store_true", help="跳过 Bonjour 发现")
    p.add_argument("--oui-file", help="自定义 OUI 厂商库文件（默认找 nmap 的 nmap-mac-prefixes）")
    p.add_argument("--columns", help="表格列，逗号分隔：name,type,ip,hostname,vendor,"
                                     "mac,ports,services,status")
    p.add_argument("--limit", type=int, help="只显示前 N 行")
    p.add_argument("--sort", choices=["ip", "name", "model", "type"], default="ip",
                   help="排序方式（默认 ip）")
    p.add_argument("-V", "--version", action="version", version=f"lanmac {VERSION}")
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    args.types = parse_type_filter(args.type_spec) if args.type_spec else []
    args.columns_explicit = bool(args.columns)
    if args.columns:
        cols = [c.strip().lower() for c in args.columns.split(",") if c.strip()]
        bad = [c for c in cols if c not in COLUMN_LABELS]
        if bad:
            raise SystemExit("lanmac: 未知列 %r，可选: %s"
                             % (",".join(bad), ",".join(COLUMN_LABELS)))
        args.columns = cols
    else:
        args.columns = list(DEFAULT_COLUMNS)
    if args.fast:
        args.browse = min(args.browse, 3.0)
        args.lookup_timeout = min(args.lookup_timeout, 2.0)

    try:
        result = discover(args)
    except KeyboardInterrupt:
        print("\n已取消", file=sys.stderr)
        return 130
    except SystemExit:
        raise
    except Exception as exc:                            # noqa: BLE001
        print(f"lanmac: 扫描失败: {exc}", file=sys.stderr)
        return 1

    devs = filter_devices(result["devices"], args)
    devs = sort_devices(devs, args.sort)
    result["total"] = len(devs)
    result["online_total"] = sum(1 for d in devs if d["online"])
    counts = {}
    for d in devs:
        counts[d["type"]] = counts.get(d["type"], 0) + 1
    result["type_counts"] = counts
    if not args.columns_explicit and not result["scanned"].get("probed"):
        args.columns = [c for c in args.columns if c != "ports"]
    if args.limit is not None and args.limit >= 0:
        devs = devs[:args.limit]
    result["devices"] = devs
    print_report(result, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
