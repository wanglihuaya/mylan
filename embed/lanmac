def parse_ifconfig(text: str):
    """解析 `ifconfig` 输出 → [{iface, ip, netmask}, ...]"""
    result, current = [], None
    for line in text.splitlines():
        m = re.match(r"^([a-z0-9]+): flags=", line)
        if m:
            current = m.group(1)
            continue
        m = re.match(r"\s+inet (\d+\.\d+\.\d+\.\d+) netmask (0x[0-9a-fA-F]+)", line)
        if m and current:
            result.append({
                "iface": current,
                "ip": m.group(1),
                "netmask": m.group(2),
            })
    return result


def netmask_to_prefix(hexmask: str) -> int:
    return bin(int(hexmask, 16)).count("1")


def parse_gateway(route_text: str):
    """从 `route -n get default` 输出解析网关 IP。"""
    m = re.search(r"gateway:\s*(\d+\.\d+\.\d+\.\d+)", route_text)
    return m.group(1) if m else None


def default_gateway():
    return parse_gateway(run_text(["route", "-n", "get", "default"]))


def system_network(iface=None, cidr=None):
    """确定要扫描的网段。返回 iface / ip / prefix / network / source。"""
    ifaces = parse_ifconfig(run_text(["ifconfig"]))

    if cidr:
        try:
            net = ipaddress.ip_network(cidr, strict=False)
        except ValueError as exc:
            raise SystemExit(
                f"lanmac: 无效网段 {cidr!r}（示例: 192.168.1.0/24）") from exc
        iface_name, local_ip = iface or "?", None
        for cand in ifaces:                     # 若指定网段包含本机地址，顺带标出本机
            if ipaddress.ip_address(cand["ip"]) in net:
                iface_name, local_ip = cand["iface"], cand["ip"]
                break
        return {
            "iface": iface_name,
            "ip": local_ip,
            "prefix": net.prefixlen,
            "network": net,
            "source": "user",
        }

    default_if = None
    m = re.search(r"interface:\s*(\w+)", run_text(["route", "-n", "get", "default"]))
    if m:
        default_if = m.group(1)

    chosen = None
    if iface:
        chosen = next((i for i in ifaces if i["iface"] == iface), None)
        if chosen is None:
            raise SystemExit(
                f"lanmac: 网卡 {iface!r} 不存在或没有 IPv4 地址（可用 ifconfig 查看）")
    if chosen is None and default_if:
        chosen = next((i for i in ifaces if i["iface"] == default_if), None)
    if chosen is None:
        # 退而求其次：常见的私网地址
        for cand in ifaces:
            if re.match(r"^(10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)", cand["ip"]):
                chosen = cand
                break
    if chosen is None:
        raise SystemExit("lanmac: 找不到可用的局域网接口，请用 -s/--subnet 指定网段")

    prefix = netmask_to_prefix(chosen["netmask"])
    net = ipaddress.ip_network(f'{chosen["ip"]}/{prefix}', strict=False)
    return {
        "iface": chosen["iface"],
        "ip": chosen["ip"],
        "prefix": prefix,
        "network": net,
        "source": "auto",
    }


def ping_host(ip: str, timeout: float) -> bool:
    try:
        p = subprocess.run(
            ["ping", "-c", "1", "-t", "1", "-W", str(int(timeout * 1000)), str(ip)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return p.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def sweep(network, timeout: float, workers: int = 64):
    """并行 ping 扫描，返回存活 IP 集合。"""
    hosts = [str(h) for h in network.hosts()]
    if not hosts:
        return set()
    alive = set()
    with ThreadPoolExecutor(max_workers=min(workers, len(hosts))) as ex:
        futures = {ex.submit(ping_host, ip, timeout): ip for ip in hosts}
        for fut in as_completed(futures):
            if fut.result():
                alive.add(futures[fut])
    return alive


ARP_RE = re.compile(
    r"\((\d+\.\d+\.\d+\.\d+)\) at ([0-9a-fA-F:]{2,}|\(incomplete\)) on (\w+)"
)


def parse_arp(text: str):
    """解析 `arp -an` → {ip: {"mac":..., "iface":...}}"""
    table = {}
    for line in text.splitlines():
        m = ARP_RE.search(line)
        if not m:
            continue
        ip, mac, iface = m.group(1), m.group(2), m.group(3)
        if mac == "(incomplete)":
            continue
        table[ip] = {"mac": mac, "iface": iface}
    return table


def arp_table():
    return parse_arp(run_text(["arp", "-an"]))


# --------------------------------------------------------------------------
# OUI 厂商库
# --------------------------------------------------------------------------

def load_oui(explicit=None):
    """加载 OUI 厂商库。返回 (table, 来源路径或 None)。"""
    candidates = [explicit] if explicit else list(OUI_PATHS)
    if not explicit:
        candidates.append(os.path.expanduser("~/.lanmac/oui.txt"))
    for path in candidates:
        if not path:
            continue
        try:
            with open(path, encoding="utf-8", errors="ignore") as f:
                table = {}
                for line in f:
                    parts = line.split(None, 1)
                    if len(parts) == 2 and re.fullmatch(r"[0-9A-Fa-f]{6}", parts[0]):
                        table[parts[0].upper()] = parts[1].strip()
                if table:
                    return table, path
        except OSError:
            continue
    return dict(FALLBACK_OUI), None


def normalize_mac(mac: str) -> str:
    """把 c8:cd:55:14:c:9a 这类补齐成 c8:cd:55:14:0c:9a。"""
    if not mac:
        return mac
    parts = re.split(r"[^0-9A-Fa-f]", mac)
    parts = [p for p in parts if p]
    if len(parts) != 6:
        return mac
    return ":".join(p.zfill(2).lower() for p in parts)


def mac_is_random(mac: str) -> bool:
    """本地管理位（第一个字节的 0x02）为 1 → 随机 MAC（隐私地址）。"""
    clean = re.sub(r"[^0-9A-Fa-f]", "", mac or "")
    if len(clean) < 2:
        return False
    return bool(int(clean[:2], 16) & 0x02)


def vendor_for(mac: str, oui) -> str:
    clean = re.sub(r"[^0-9A-Fa-f]", "", mac or "").upper()
    if len(clean) < 6:
        return ""
    if mac_is_random(clean):
        return "随机 MAC"
    return oui.get(clean[:6], "")


