# Bonjour / mDNS
# --------------------------------------------------------------------------

def parse_browse(lines, service: str):
    """解析 `dns-sd -B` 输出，返回出现过的实例名列表。"""
    names = []
    for line in lines:
        parts = line.split()
        # 形如: 11:31:33.388  Add        2  14 local.  _ssh._tcp.  xlsd的Mac mini
        if len(parts) < 7 or parts[1] not in ("Add", "Rmv"):
            continue
        if parts[1] != "Add":
            continue
        svc = parts[5].rstrip(".")
        if svc != service.rstrip("."):
            continue
        name = " ".join(parts[6:]).strip()
        if name:
            names.append(name)
    return names


LOOKUP_RE = re.compile(r"can be reached at (\S+?):(\d+)")


def parse_lookup(lines):
    """解析 `dns-sd -L` 输出 → (host, port, txt dict)"""
    host, port, txt = None, None, {}
    for line in lines:
        m = LOOKUP_RE.search(line)
        if m:
            host = m.group(1).rstrip(".")
            port = int(m.group(2))
        for k, v in re.findall(r"(\w+)=(\S+)", line):
            txt.setdefault(k, v)
    return host, port, txt


def resolve_host(host: str, network=None):
    """用 mDNS 解析 *.local → IPv4；优先返回当前网段内的地址。"""
    host = host.rstrip(".")
    try:
        infos = socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_DGRAM)
    except (socket.gaierror, OSError):
        return None
    ips = []
    for info in infos:
        ip = info[4][0]
        if ip.startswith("127.") or ip.startswith("169.254."):
            continue
        if ip not in ips:
            ips.append(ip)
    if network is not None:
        inside = [ip for ip in ips if ipaddress.ip_address(ip) in network]
        if inside:
            return inside[0]
    return ips[0] if ips else None


def resolve_via_dns_sd(host: str, seconds: float, network=None):
    """getaddrinfo 失败时，退回 `dns-sd -G v4`。"""
    if not have("dns-sd"):
        return None
    lines = run_stream(["dns-sd", "-G", "v4", host.rstrip(".") + "."], seconds)
    ips = []
    for line in lines:
        if " Add " not in f" {line} ":
            continue
        for ip in re.findall(r"\b(\d+\.\d+\.\d+\.\d+)\b", line):
            if ip.startswith("127.") or ip.startswith("169.254."):
                continue
            if ip not in ips:
                ips.append(ip)
    if network is not None:
        inside = [ip for ip in ips if ipaddress.ip_address(ip) in network]
        if inside:
            return inside[0]
    return ips[0] if ips else None


def browse_service(service: str, seconds: float):
    if not have("dns-sd"):
        return []
    lines = run_stream(["dns-sd", "-B", service, "local."], seconds)
    return parse_browse(lines, service)


def clean_instance_name(name: str, service: str) -> str:
    """整理 Bonjour 实例名（去掉 AirPlay 音频类的 MAC@ 前缀等）。"""
    name = name.strip()
    if "@" in name:
        head, tail = name.split("@", 1)
        if re.fullmatch(r"[0-9A-Fa-f]{8,}", head):
            name = tail.strip()
    return name


def lookup_device(name: str, services, seconds: float, network=None):
    """解析单个实例：主机名 / 端口 / TXT(机型) / IP。"""
    preferred = "_airplay._tcp" if "_airplay._tcp" in services else sorted(services)[0]
    lines = run_stream(
        ["dns-sd", "-L", name, preferred, "local."], seconds,
        stop_when=lambda ls: any("can be reached at" in l for l in ls),
    )
    host, port, txt = parse_lookup(lines)
    ip = None
    if host:
        ip = resolve_host(host, network) or resolve_via_dns_sd(host, seconds, network)
    return {"hostname": host, "port": port, "txt": txt, "ip": ip}


def probe_port(ip: str, port: int, timeout: float = 0.35) -> bool:
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except (OSError, socket.timeout):
        return False


def smb_name(ip: str, timeout: float = 1.5):
    """用 `smbutil status` 拿 Windows/Samba 的机器名。"""
    if not have("smbutil"):
        return None
    try:
        out = subprocess.run(
            ["smbutil", "status", ip], capture_output=True, text=True, timeout=timeout
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"^Server:\s*(.+)$", out or "", re.M)
    return m.group(1).strip() if m else None


