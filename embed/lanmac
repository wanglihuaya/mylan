# --------------------------------------------------------------------------
# 小工具
# --------------------------------------------------------------------------

def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run_text(cmd, timeout=10) -> str:
    """执行命令，返回 stdout 文本（失败返回空串）。"""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout or ""
    except (OSError, subprocess.SubprocessError):
        return ""


def run_stream(cmd, seconds: float, stop_when=None, grace: float = 0.25):
    """执行会持续输出命令（如 dns-sd），收集输出行。

    seconds 为最长等待；若提供 stop_when(lines)->bool，满足后会在 grace 秒的
    缓冲窗口后提前结束（用于拿到 TXT 等紧随其后的行）。
    """
    try:
        p = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, bufsize=1,
        )
    except (OSError, subprocess.SubprocessError):
        return []

    lines = []
    lock = threading.Lock()

    def reader():
        try:
            for line in p.stdout:
                with lock:
                    lines.append(line.rstrip("\n"))
                if len(lines) > 5000:      # 兜底，防止异常输出撑爆内存
                    break
        except (OSError, ValueError):
            pass

    t = threading.Thread(target=reader, daemon=True)
    t.start()
    deadline = time.time() + seconds
    hit = False
    while time.time() < deadline:
        if stop_when is not None:
            with lock:
                snapshot = list(lines)
            try:
                if stop_when(snapshot):
                    hit = True
                    break
            except Exception:                       # noqa: BLE001 - 判断函数异常不影响收集
                pass
        if not t.is_alive():
            break
        time.sleep(0.02)

    if hit:                                        # 给 TXT 等后续行一点时间
        grace_end = min(time.time() + grace, deadline)
        while time.time() < grace_end and t.is_alive():
            time.sleep(0.02)

    for action in (p.terminate, p.kill):
        try:
            action()
            p.wait(timeout=1)
            break
        except (OSError, subprocess.SubprocessError):
            continue

    with lock:
        return list(lines)


def dwidth(s: str) -> int:
    """按终端显示宽度计算字符串长度（中日韩全角字符占 2 列）。"""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s: str, width: int) -> str:
    return s + " " * max(0, width - dwidth(s))


def truncate(s: str, width: int) -> str:
    """按显示宽度截断，超出部分用 … 表示。"""
    if dwidth(s) <= width:
        return s
    out, used = [], 0
    for ch in s:
        w = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if used + w > width - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "…"


